{
  "description": "Escudo de compactación (checkpoint antes de /compact y contexto restaurado después) y aviso de órdenes pendientes del buzón al abrir o retomar sesión.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_compact.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"${CLAUDE_PLUGIN_ROOT}/hooks/inbox_peek.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
